{
  "name": "homehub-tvos",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "build:tvos": "eas build --platform ios --profile preview",
    "build:tvos:sim": "eas build --platform ios --profile preview-simulator",
    "build:tvos:prod": "eas build --platform ios --profile production"
  },
  "expo": {
    "install": {
      "exclude": ["react-native"]
    }
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "npm:react-native-tvos@0.76.9-0",
    "react-native-webview": "13.12.5",
    "@react-native-tvos/config-tv": "^0.1.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0"
  },
  "private": true
}
