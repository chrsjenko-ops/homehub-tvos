{
  "expo": {
    "name": "HomeHub TV",
    "slug": "homehub-tvos",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "ios": {
      "isTV": true,
      "supportsTablet": false,
      "bundleIdentifier": "com.homehub.tvos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "tvosDeploymentTarget": "15.1"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "3e2bfa0c-6e74-4717-be3f-d9a06322204c"
      }
    }
  }
}
